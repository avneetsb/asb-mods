{
  "_description": "Template files for generating per-tool hook configurations",
  "version": "1.0.0",
  "hook_templates": {
    "pre_tool_use": {
      "description": "Run before every tool use",
      "claude_template": "if [[ \"${TOOL_NAME}\" == \"Bash\" ]]; then rtk hook claude; fi",
      "codex_template": "# Paseo PreToolUse hook triggers here",
      "cursor_template": "# Cursor PreToolUse registered via cli-config.json"
    },
    "post_tool_use": {
      "description": "Run after every tool use",
      "claude_template": "node ~/.claude/hooks/gitnexus/gitnexus-hook.cjs",
      "codex_template": "# Paseo PostToolUse hook triggers here"
    },
    "session_start": {
      "description": "Run at session start",
      "claude_template": "bash ~/.claude/tools-setup/verify-tools.sh",
      "codex_template": "# Paseo SessionStart hook triggers here"
    },
    "session_end": {
      "description": "Run at session end",
      "claude_template": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then paseo hooks claude SessionEnd; fi",
      "codex_template": "# Paseo SessionEnd hook triggers here"
    }
  }
}