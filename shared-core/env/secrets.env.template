#!/bin/bash
# asb-mods secret/environment template — the list of variables `asbmods secrets` prompts for.
#
# Values are NEVER stored in this file: the installer writes what you type to
#   ~/.config/asb-mods/env/secrets.env   (mode 600, outside any repo)
# and shared-core/env/shell-env.sh sources that file. This template holds names only.
#
# To add a variable for your own setup, add an uncommented NAME="" line here; the next
# `asbmods secrets` run will prompt for it.

# --- Hugging Face token (graphify embeddings, htmldocx) ---
HF_TOKEN=""

# --- System One decision-model API key ---
SYSTEM_ONE_API_KEY=""

# --- OMLX local inference endpoint (no key required when served from localhost) ---
OMLX_API_KEY=""
OMLX_BASE_URL="http://127.0.0.1:1234/v1"

# --- Anthropic gateway for Claude Code (enterprise installs set both) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""

# --- OpenAI-compatible local endpoint used by graphify/prompt tooling ---
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# --- Misc tool auth ---
DEEPCODE_TOKEN=""
CODX_AUTH_TOKEN=""
