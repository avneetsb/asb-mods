  "version": "1.0.0",
  "mcp": {
    "mcpServers": {
      "obsidian-connect-readwrite": {
        "url": "https://mcp.internal.example/mcp/groups/example-user/obsidian-connect-readwrite"
      },
      "gitnexus": {
        "command": "/Users/example/.local/bin/gitnexus",
